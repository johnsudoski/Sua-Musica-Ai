# ─── Servidor ───────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_URL=https://SUA_URL.railway.app
FRONTEND_URL=*

# ─── Suno API via apiframe.ai ───────────────────────────
# Cadastre em: https://apiframe.ai  → Copie a API Key
APIFRAME_API_KEY=sua_chave_aqui

# ─── Creatomate (geração de vídeo com letra) ────────────
# Cadastre em: https://creatomate.com → Free: 100 vídeos/mês
# Copie a API Key em: Settings → API Keys
CREATOMATE_API_KEY=sua_chave_creatomate_aqui

# ─── Ticto ──────────────────────────────────────────────
# IDs dos produtos no painel Ticto (já na URL de checkout)
TICTO_MP3_PRODUCT=OD11F0BEB
TICTO_VIDEO_PRODUCT=OD8AA1433
# Chave secreta do webhook Ticto (painel Ticto → Webhooks)
TICTO_WEBHOOK_SECRET=

# ─── Email ──────────────────────────────────────────────
# Opção A: Gmail com App Password (mais fácil para começar)
#   1. Ative verificação em 2 etapas no Gmail
#   2. Acesse: myaccount.google.com/apppasswords
#   3. Gere uma senha de app "Mail"
GMAIL_USER=seu@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Opção B: SMTP genérico (Resend, Brevo, etc.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx

EMAIL_FROM=SuaMúsicaAI <noreply@suamusicaai.com.br>

# ─── Meta / Facebook Pixel ──────────────────────────────
# Pixel ID: encontrado no Gerenciador de Eventos do Meta
FACEBOOK_PIXEL_ID=1333066069024820
# Token da API de Conversões (Conversions API — eventos server-side)
# NÃO colocar este token em nenhum arquivo frontend
FACEBOOK_ACCESS_TOKEN=

# ─── Kiwify (alternativa ao Ticto) ──────────────────────
# KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/SEU_PRODUTO
# KIWIFY_WEBHOOK_SECRET=
